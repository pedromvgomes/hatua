{
  "name": "@hatua/layout",
  "version": "0.1.0",
  "type": "module",
  "description": "Internal to @hatua/react — published because it is an external of its build, not a supported API. Derived layout: step tree in, flow-map geometry out.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcovonly"
  },
  "dependencies": {
    "@hatua/model": "workspace:*",
    "@hatua/schema": "workspace:*"
  }
}
