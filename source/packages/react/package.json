{
  "name": "@hatua/react",
  "version": "0.1.1",
  "type": "module",
  "description": "The Hatua workflow designer: React components, hooks and theming",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedromvgomes/hatua.git",
    "directory": "source/packages/react"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcovonly --passWithNoTests",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@hatua/document": "workspace:*",
    "@hatua/expressions": "workspace:*",
    "@hatua/layout": "workspace:*",
    "@hatua/log": "workspace:*",
    "@hatua/model": "workspace:*",
    "@hatua/schema": "workspace:*",
    "@hatua/services": "workspace:*"
  },
  "devDependencies": {
    "@hatua/document": "workspace:*",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.0"
  }
}
