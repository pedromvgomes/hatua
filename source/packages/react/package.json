{
  "name": "@hatua/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Hatua workflow designer: React components, hooks and theming",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@hatua/layout": "workspace:*",
    "@hatua/model": "workspace:*",
    "@hatua/schema": "workspace:*",
    "@hatua/services": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.5.7"
  }
}
