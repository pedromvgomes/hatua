{
  "name": "@hatua/model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure domain rules over the step tree: references, scope, validation",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcovonly --passWithNoTests"
  },
  "dependencies": {
    "@hatua/expressions": "workspace:*",
    "@hatua/schema": "workspace:*",
    "@hatua/document": "workspace:*"
  }
}
