{
  "name": "@hatua/services",
  "version": "0.1.1",
  "type": "module",
  "description": "Internal to @hatua/react — published because it is an external of its build, not a supported API. Editing commands, undo/redo, validation orchestration and Host ports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedromvgomes/hatua.git",
    "directory": "source/packages/services"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcovonly --passWithNoTests"
  },
  "dependencies": {
    "@hatua/schema": "workspace:*",
    "@hatua/document": "workspace:*",
    "@hatua/model": "workspace:*",
    "@hatua/layout": "workspace:*",
    "@hatua/expressions": "workspace:*",
    "@hatua/log": "workspace:*"
  }
}
