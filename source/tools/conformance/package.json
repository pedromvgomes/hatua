{
  "name": "@hatua/conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runs the shared fixture corpus against the TypeScript implementation; sdk/go runs the same files",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcovonly",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hatua/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "yaml": "^2.8.1"
  }
}
