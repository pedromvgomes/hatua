{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.turbo", "!**/coverage", "!apps/playground/public"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": "error",
      "correctness": "error"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/expressions/src/generated/**",
        "packages/expressions/src/generated.staged/**"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/react/src/primitives/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@hatua/**",
                      "**/compounds/**",
                      "**/blocks/**",
                      "**/layouts/**",
                      "**/views/**"
                    ],
                    "message": "primitives carry no domain knowledge: no @hatua/* packages and no higher tiers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/react/src/compounds/**", "packages/react/src/blocks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@hatua/services", "**/layouts/**", "**/views/**"],
                    "message": "compounds and blocks are presentational: props in, events out. Only layouts, views and the provider may reach @hatua/services."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/fixtures.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
