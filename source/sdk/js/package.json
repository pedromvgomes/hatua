{
  "name": "@hatua/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Hatua SDK for Node backends and workflow runners \u2014 the contract plus the shared expression evaluator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedromvgomes/hatua.git",
    "directory": "source/sdk/js"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcovonly"
  },
  "dependencies": {
    "@hatua/expressions": "workspace:*",
    "@hatua/model": "workspace:*",
    "@hatua/schema": "workspace:*",
    "yaml": "^2.8.1"
  }
}
