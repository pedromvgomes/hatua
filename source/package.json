{
  "name": "hatua",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "turbo run dev",
    "codegen": "pnpm --filter @hatua/codegen generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@vitest/coverage-v8": "^3.2.7",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.4"
  }
}
