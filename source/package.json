{
  "name": "hatua",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "turbo run dev",
    "codegen": "pnpm --filter @hatua/codegen generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.1"
  }
}
