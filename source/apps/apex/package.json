{
  "name": "@hatua/apex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Serves the hatua.dev apex — the go-import tag for hatua.dev/go — not published",
  "scripts": {
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcovonly"
  },
  "devDependencies": {
    "wrangler": "^4.131.2"
  }
}
